# Org identity — see prd.md Section 8, 15 ("Key handling")
TAWF_ORG_ID=laz-example
# 32-byte salt, base64 or hex. NEVER commit this. Losing it makes existing proofs unverifiable.
TAWF_ORG_SALT=

# Hosted mode (packages/verify-server, apps/verify-service)
TAWF_API_KEY=

# Self-host mode: chain + signer + registry address
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
TAWF_SIGNER_PRIVATE_KEY=
TAWF_REGISTRY_ADDRESS=
