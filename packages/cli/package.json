{
  "name": "@tawf/verify-cli",
  "version": "0.1.0",
  "description": "tawf-verify CLI. `check` is fully real (no API key, no Tawf infrastructure, per prd.md Section 11.3/G3). init/record/prove/audit are stubs.",
  "type": "module",
  "bin": {
    "tawf-verify": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "format": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@tawf/verify-core": "workspace:*",
    "@tawf/verify-server": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^1.6.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
