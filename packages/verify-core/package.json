{
  "name": "@tawf/verify-core",
  "version": "0.1.0",
  "description": "Canonicalization, leaf hashing, Merkle tree construction, and proof verification for tawf-verify. Isomorphic, zero network calls, zero chain dependency.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "typescript": "^5.8.0",
    "vitest": "^1.6.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
