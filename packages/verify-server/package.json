{
  "name": "@tawf/verify-server",
  "version": "0.1.0",
  "description": "Node/Bun server SDK: record buffering, batch scheduling, anchor submission. Stub — see README for what's mocked.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "format": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@tawf/verify-core": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^1.6.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
